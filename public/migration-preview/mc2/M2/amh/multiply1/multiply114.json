        "content": {
          "blocks": [
            {
              "type": "paragraph",
              "data": {
                "text": "ከመጽሐፍ ቅዱስ ክፍል አንብብና በዝማሬ አምልኩ።ማቴ 10፡28-30፤ በፊል 2፡11፤ እና 1ጢሞ 2፡4-6"
              }
