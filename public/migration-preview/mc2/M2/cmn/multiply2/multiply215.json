    {
      "type": "list",
      "data": {
        "style": "unordered",
        "items": [
          {
            "text": "<strong>故事重述</strong>",
            "children": {
              "style": "unordered",
              "items": [
                {
                  "text": "再读一次这段故事。请小组中一个人口头讲述这故事，并根据需要作更正。"
                }
              ]
            }
          }
        ]
