                "text": "路2:52"
              }
            },
            {
              "type": "paragraph",
              "data": {
                "text": "耶穌的智慧和身量（註：或作：“年紀”），並　神和人喜愛他的心，都一齊增長。"
              }
            }
          ],
          "version": "2.31.5"
        }
      }
    },
    {
      "type": "notesArea",
