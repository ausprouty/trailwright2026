              }
            },
            {
              "type": "paragraph",
              "data": {
                "text": "耶穌見他們的信心，就對癱子說：“你的罪赦了。”"
              }
            }
          ],
          "version": "2.31.5"
        }
      }
    },
    {
      "type": "notesArea",
      "data": {
