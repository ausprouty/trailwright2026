                    "marker": "Psalm 92:1-2",
                    "label": "Psalm 92:1-2",
                    "passage": "<h4>A psalm. A song. For the Sabbath day.</h4><p><sup>1</sup>It is good to praise the<span class=\"small-caps\">Lord<br>and make music to your name, O Most High,<br><sup>2</sup>proclaiming your love in the morning<br>and your faithfulness at night,</span></p>"
                  }
