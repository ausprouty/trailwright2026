    {
      "type": "collapsibleGroup",
      "data": {
        "title": "Preparar para a Missão",
        "isOpen": false,
        "content": {
          "blocks": [
            {
              "type": "list",
              "data": {
                "style": "unordered",
                "items": [
                  {
                    "text": "Praticar compartilhar o evangelho"
                  },
                  {
                    "text": "Lembre-os do que fazer quando alguém diz SIM ao evangelho."
                  }
                ]
              }
            }
          ],
          "version": "2.31.5"
        }
      }
    },
    {
      "type": "header",
      "data": {
        "text": "Partir para a Missão",
        "level": 2
      }
    },
    {
      "type": "list",
      "data": {
        "style": "unordered",
        "items": [
          {
            "text": "Crie uma Lista de Relacionamentos escrevendo os nomes de 10 ou mais pessoas que eles conhecem."
          },
          {
            "text": "Identifique 5 pessoas de sua Lista de Relacionamentos com quem você possa compartilhar esta história ou o evangelho esta semana."
          },
          {
            "text": "Escreva suas declarações “Eu vou_____” e compartilhe-as com seu grupo."
          }
        ]
      }
    },
    {
      "type": "notesArea",
      "data": {
        "notes": "",
