  "blocks": [
    {
      "type": "sectionMarker",
      "data": {
        "theme": "back",
        "title": "பின்னிட்டு பார்க்கவும்",
        "icon": "arrow-left"
      }
    },
    {
      "type": "list",
      "data": {
        "style": "ordered",
        "items": [
          "இந்த வாரத்தில் எதற்கு நன்றி கூருகின்றீர்கள்?",
          "எதனோடு போராடுகின்றீர்கள்? நாங்கள் எவ்வாறு உதவுவது?",
          "நமது சமூகம்/வளாகம்/பள்ளியில் என்ன தேவைகளைக் காண்கிறீர்கள்?"
        ]
      }
    },
    {
      "type": "iconList",
      "data": {
        "items": [
          {
            "icon": "prayer",
            "text": "அந்த தேவைகளைக் குறித்து ஒருவருக்கொருவர் ஜெபிப்பது நல்லது."
          }
        ]
      }
    },
    {
      "type": "notesArea",
      "data": {
        "notes": "",
        "storageKey": "note"
      }
    },
    {
      "type": "sectionMarker",
      "data": {
        "theme": "up",
        "title": "மேற்கொண்டு காண",
        "icon": "arrow-up"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "<span class=\"color-yellow\">குறிப்பு 1:</span> கர்த்தர் உங்களை நேசிக்கிறார். அவரைத் தனிப்பட்ட முறையில் அறியவே படைத்து உள்ளார்."
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "<span class=\"color-yellow\">குறிப்பு 2:</span> நமது பாவத்தினால் பிரிக்கப்பட்டு உள்ளபடியால் அவரை அறியவோ, அவரது அன்பை அனுபவிக்கவோ முடியாது."
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "<span class=\"color-yellow\">குறிப்பு 3:</span> இயேசு மட்டுமே நமது பாவத்திற்க்கான கர்த்தருடைய ஒரே தீர்வு. அவர் மூலமாய் கர்த்தரை அறியவும், அவரது அன்பு மற்றும் மன்னிப்பைப் பெறவும் முடியும்."
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "<span class=\"color-yellow\">குறிப்பு 4:</span> நமது நம்பிக்கையை ஆண்டவரும் இரட்சகருமாகிய இயேசுவின் மீது வைத்து பதில் தர வேண்டும். அதன் மூலமே, கர்த்தரை தனிப்பட்ட முறையில் நாம் அறிய முடியும்."
      }
    },
    {
      "type": "header",
      "data": {
        "text": "எனது சாட்சி",
        "level": 3
      }
    },
    {
      "type": "list",
      "data": {
        "style": "ordered",
        "items": [
          "இயேசுவை சந்த்திக்கும் முன் எனது வாழ்வு",
          "நான் இயேசுவை எவ்வாறு சந்த்தித்தேன்",
          "நான் இயேசுவை சந்த்தித்ததில் இருந்து எனது வாழ்வு எவ்வாறு மாறியது?"
        ]
      }
    },
    {
      "type": "notesArea",
      "data": {
        "notes": "",
        "storageKey": "note"
      }
    },
    {
      "type": "sectionMarker",
      "data": {
        "theme": "forward",
        "title": "மூன்னோக்கிப் பார்க்க",
        "icon": "arrow-right"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "நாம் கற்றதை செயல்படுத்துவது மிக முக்கியம். மேலும்,அதனைச் செய்ய ஒருவருக்கொருவர் உதவ வேண்டும். சில கேள்விகள் அதைச் செய்ய உதவும்:"
      }
    },
    {
      "type": "list",
      "data": {
        "style": "ordered",
        "items": [
          "நீங்கள் வாழ்வதை இது எவ்வாறு மாற்ற்லாம்? மாற்றும்? கர்த்தரோடு? தன்னோடு? பிறரோடு?",
          "இந்த வார உரையாடலில் இருந்து எதை உங்கள் வாழ்வில் செயல்படுத்த விரும்புவீர்கள்? அதனைச் செய்ய என்ன மாற்றம் செய்வீர்கள்?",
          "இந்த வாரம் கற்றதை யாரோடு பகிர்ந்து கொள்வீர்கள்? என்ன கூருவீர்கள்?"
        ]
      }
    },
    {
      "type": "iWill",
      "data": {
        "storageKey": "firststeps-step1-i-will"
      }
    }
  ]
